# 复制本文件为 .env 并填入真实密钥；.env 不会被提交
DASHSCOPE_API_KEY=your-real-key-here
# 默认只显示关键阶段/耗时/异常；-v或DEBUG开启细节，正文预览须单独开启。
LOG_LEVEL=INFO
LOG_PAYLOADS=false
# 交互模式按需检索
# false：检索可用时不预载正文；true：保留原始上下文作为对照。
# 无检索工具时，无论此开关为何值，都保留原始资料上下文。
INTERACTIVE_PRELOAD_MATERIALS=false
INTERACTIVE_MAX_RETRIEVAL_CALLS=1
INTERACTIVE_MAX_QUERIES_PER_TOOL_CALL=3
INTERACTIVE_RETRIEVAL_MAX_CONTEXT_CHARS=24000
# 默认：资料分析、计划生成、普通交互与对话摘要
CHAT_MODEL=qwen3.7-plus
# 自然语言反馈解析
FEEDBACK_MODEL=qwen3.8-flash
# 预留增强模型，当前命令行无切换入口
ENHANCED_MODEL=qwen3.8-max
# 本机 IPv6 不可达时开启；仅影响同步聊天与 embedding 的连接，不修改系统网络。
API_FORCE_IPV4=false
# chat使用CHAT_BASE_URL和DASHSCOPE_API_KEY；dashscope恢复按量专用重排。
RAG_RERANK_ENABLED=true
RAG_RERANK_BACKEND=chat
RAG_RERANK_CHAT_MODEL=deepseek-v4.1-flash
# 下列模型仅在RAG_RERANK_BACKEND=dashscope时使用。
RAG_RERANK_MODEL=qwen3.7-text-rerank
RAG_RERANK_CANDIDATE_LIMIT=16
RAG_RERANK_TIMEOUT_S=15
# 资料分析阶段：模型决策轮数、工具执行总数、连续无执行进展轮数。
AGENT_MAX_TOOL_ROUNDS=12
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_NO_PROGRESS_ROUNDS=2
# dense 保留原基线；hybrid 使用 RRF＋重排，异常时回退向量检索。
RAG_RETRIEVAL_STRATEGY=dense
RAG_HYBRID_MIN_RERANK_SCORE=0.5
